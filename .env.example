# LLM — OpenAI-compatible chat completions endpoint. Point this at any
# compatible provider/aggregator without touching code:
#   - DeepSeek direct:    LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#   - aiand.com aggregator: LLM_BASE_URL=https://api.aiand.com/v1    LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Optional: low/medium/high — only meaningful for reasoning models
# (e.g. gpt-oss-120b). Leave empty for non-reasoning models like deepseek-chat.
LLM_REASONING_EFFORT=

# Optional: web search tool (real-time info, e.g. "film terbaru"). Get a free
# key at tavily.com. Leave empty to disable — bot will admit it doesn't know
# instead of guessing/hallucinating recent info.
TAVILY_API_KEY=

# Owner's own WhatsApp number (with country code, no +, no spaces), e.g. 6281234567890
# Used as: default whitelist entry, recipient of the daily morning reminder.
OWNER_NUMBER=

# Word/phrase that triggers the bot when mentioned in a group chat (case-insensitive substring match)
BOT_TRIGGER_NAME=bot

# Daily reminder time (24h, server-local time)
REMINDER_HOUR=7
REMINDER_MINUTE=0

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=change-this-to-a-random-string

PORT=3000

# Optional: Google Calendar skill. Create an OAuth Client ID (type "Web app")
# at console.cloud.google.com, add GOOGLE_REDIRECT_URI to its Authorized
# redirect URIs, then connect from the dashboard's Calendar tab.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Optional: YouTube Data API v3 key (plain API key, no OAuth) — enables the
# "carikan video ..." skill. Leave empty to disable.
YOUTUBE_API_KEY=

# Optional: GitHub Personal Access Token — enables repo/PR/issue skills.
# Fine-grained token with Contents (read) + Issues (read/write) + Pull
# requests (read) on the repos you want, or classic token with `repo` scope.
GITHUB_TOKEN=
